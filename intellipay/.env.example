# IntelliPay credentials — NEVER commit the real .env
IPAY_MERCHANT_KEY=your_merchant_key
IPAY_API_KEY=your_api_key
# Auth key used to validate the HMAC on responses (request from IntelliPay)
IPAY_AUTH_KEY=your_auth_key
# secure.cpteller.com = production | test.cpteller.com = sandbox
IPAY_HOST=test.cpteller.com
IPAY_BEARER=cpt_test_...
