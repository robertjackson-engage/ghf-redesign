# GHF CMS backend — copy to .env locally; on Azure these are App Settings (deploy-azure.sh sets them from .env)

# GitHub: ONE fine-grained token the service uses for every edit. Editors never get one.
#   github.com → Settings → Developer settings → Fine-grained tokens → Generate
#   Repository access: Only select repositories → ghf-redesign
#   Permissions: Contents = Read and write      (nothing else)
CMS_GITHUB_TOKEN=
CMS_REPO=robertjackson-engage/ghf-redesign
CMS_BRANCH=main

# Microsoft Entra ID (the club's Microsoft 365). See README.md → "Microsoft app registration".
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Who may edit: only accounts whose email is in these domains (comma list). Empty = anyone in the tenant.
CMS_ALLOWED_DOMAINS=ghfc.com

# Where this service runs, and which CMS sites may talk to it
CMS_PUBLIC_URL=https://ghf-cms.azurewebsites.net
CMS_ALLOWED_ORIGINS=https://robertjackson-engage.github.io,http://localhost:4173

# Random string that signs editor sessions (any long random value; rotate to log everyone out)
CMS_SESSION_SECRET=
